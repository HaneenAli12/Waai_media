{
    "info": {
        "_postman_id": "c71a39f0-d5a2-4d1e-8e54-202610240001",
        "name": "Waai Media - Event Calendar API",
        "description": "Official Postman Collection (v2.1) for the Waai Media Event Calendar Module (Laravel 13 API Backend).\n\n### Authentication & Roles\n- **Public Endpoints**: No authentication required.\n- **Admin Endpoints**: Require Bearer token with 'access' ability (`admin` or `editor` role).\n- **Delete Endpoint**: Restricted strictly to `admin` role (returns HTTP 403 Forbidden for `editor`).\n\n### Date and Time Handling\n- Local dates/times are supplied with an IANA timezone identifier (e.g. `Asia/Riyadh`, `Africa/Cairo`).\n- Stored and returned in standard UTC ISO 8601 Zulu format (`YYYY-MM-DDTHH:mm:ss.000000Z`).\n\n### Collection Variables\n- `baseUrl`: Base API URL (default: `https://api.waaimedia.com`).\n- `adminToken`: Bearer access token for Administrator role.\n- `editorToken`: Bearer access token for Editor role.\n- `eventId`: Auto-saved from Create Draft response or manually specified.\n- `slug`: Auto-saved from Create Draft response or manually specified.",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "variable": [
        {
            "key": "baseUrl",
            "value": "https://api.waaimedia.com",
            "type": "string"
        },
        {
            "key": "adminToken",
            "value": "your_admin_access_token_here",
            "type": "string"
        },
        {
            "key": "editorToken",
            "value": "your_editor_access_token_here",
            "type": "string"
        },
        {
            "key": "eventId",
            "value": "1",
            "type": "string"
        },
        {
            "key": "slug",
            "value": "tech-summit-2026-1",
            "type": "string"
        }
    ],
    "item": [
        {
            "name": "1. Public Events",
            "item": [
                {
                    "name": "1.1 List Published Events (Default 20 per page)",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/api/v1/events?timeline=upcoming&page=1&per_page=20",
                            "host": ["{{baseUrl}}"],
                            "path": ["api", "v1", "events"],
                            "query": [
                                {
                                    "key": "timeline",
                                    "value": "upcoming",
                                    "description": "Timeline filter: upcoming (default), past, latest, all"
                                },
                                {
                                    "key": "page",
                                    "value": "1",
                                    "description": "Page number"
                                },
                                {
                                    "key": "per_page",
                                    "value": "20",
                                    "description": "Items per page (1-100, default 20)"
                                },
                                {
                                    "key": "category",
                                    "value": "Technology",
                                    "disabled": true,
                                    "description": "Optional category filter"
                                }
                            ]
                        },
                        "description": "Lists published events eligible for public display (published_at <= now). Excludes drafts strictly."
                    }
                },
                {
                    "name": "1.2 Get Published Event by Slug",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            },
                            {
                                "key": "Accept-Language",
                                "value": "ar",
                                "disabled": true,
                                "description": "Optional locale header (ar or en) for content localization"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/api/v1/events/{{slug}}",
                            "host": ["{{baseUrl}}"],
                            "path": ["api", "v1", "events", "{{slug}}"]
                        },
                        "description": "Fetches a single published event by its unique URL slug. Returns HTTP 404 if draft or not found."
                    }
                }
            ]
        },
        {
            "name": "2. Admin Events Management",
            "item": [
                {
                    "name": "2.1 Admin - List Events (Default 10 per page)",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{adminToken}}"
                            },
                            {
                                "key": "Accept",
                                "value": "application/json"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/api/v1/admin/events?page=1&per_page=10",
                            "host": ["{{baseUrl}}"],
                            "path": ["api", "v1", "admin", "events"],
                            "query": [
                                {
                                    "key": "page",
                                    "value": "1",
                                    "description": "Page number"
                                },
                                {
                                    "key": "per_page",
                                    "value": "10",
                                    "description": "Items per page (default 10, configurable up to 100)"
                                },
                                {
                                    "key": "status",
                                    "value": "draft",
                                    "disabled": true,
                                    "description": "Status filter: draft or published"
                                },
                                {
                                    "key": "timeline",
                                    "value": "upcoming",
                                    "disabled": true,
                                    "description": "Timeline filter: upcoming or past"
                                }
                            ]
                        },
                        "description": "Lists all events (both Draft and Published) for Admin Dashboard table view with default 10 events per page."
                    }
                },
                {
                    "name": "2.2 Admin - Search by English Name (Case-Insensitive)",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{adminToken}}"
                            },
                            {
                                "key": "Accept",
                                "value": "application/json"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/api/v1/admin/events?search=tech%20summit",
                            "host": ["{{baseUrl}}"],
                            "path": ["api", "v1", "admin", "events"],
                            "query": [
                                {
                                    "key": "search",
                                    "value": "tech summit",
                                    "description": "Case-insensitive title search (SQL-safe escaped for % and _)"
                                }
                            ]
                        },
                        "description": "Demonstrates case-insensitive search by English event name (matches 'Tech Summit', 'tech summit', etc.)."
                    }
                },
                {
                    "name": "2.3 Admin - Create Draft Event",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test('Status code is 201 Created', function () {",
                                    "    pm.response.to.have.status(201);",
                                    "});",
                                    "",
                                    "var jsonData = pm.response.json();",
                                    "if (jsonData && jsonData.data) {",
                                    "    if (jsonData.data.id) {",
                                    "        pm.collectionVariables.set('eventId', jsonData.data.id.toString());",
                                    "        console.log('Saved eventId: ' + jsonData.data.id);",
                                    "    }",
                                    "    if (jsonData.data.slug) {",
                                    "        pm.collectionVariables.set('slug', jsonData.data.slug);",
                                    "        console.log('Saved slug: ' + jsonData.data.slug);",
                                    "    }",
                                    "}"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{adminToken}}"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            },
                            {
                                "key": "Accept",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"name_en\": \"Global Future Media Summit 2026\",\n    \"name_ar\": \"القمة العالمية للإعلام المستقبلي 2026\",\n    \"category_en\": \"Media\",\n    \"category_ar\": \"الإعلام\",\n    \"place_en\": \"Riyadh International Exhibition Center\",\n    \"place_ar\": \"مركز الرياض الدولي للمعارض والمؤتمرات\",\n    \"description_en\": \"A premier gathering of media innovators and digital broadcast pioneers.\",\n    \"description_ar\": \"تجمع رائد لنخبة من مبتكري الإعلام ورواد البث الرقمي الحديث.\",\n    \"event_date\": \"2026-11-20 18:30:00\",\n    \"timezone\": \"Asia/Riyadh\",\n    \"cover_image_url\": \"https://images.unsplash.com/photo-1540575467063-178a50c2df87\",\n    \"url\": \"https://waaimedia.com/events/summit-2026\"\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/api/v1/admin/events",
                            "host": ["{{baseUrl}}"],
                            "path": ["api", "v1", "admin", "events"]
                        },
                        "description": "Creates a new event in Draft status. Automatically saves returned `eventId` and `slug` to collection variables."
                    }
                },
                {
                    "name": "2.4 Admin - Get Event Details",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{adminToken}}"
                            },
                            {
                                "key": "Accept",
                                "value": "application/json"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/api/v1/admin/events/{{eventId}}",
                            "host": ["{{baseUrl}}"],
                            "path": ["api", "v1", "admin", "events", "{{eventId}}"]
                        },
                        "description": "Retrieves the complete administrative view of an event by ID (accessible by Admin or Editor)."
                    }
                },
                {
                    "name": "2.5 Admin - Update Event (Partial / Full)",
                    "request": {
                        "method": "PUT",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{adminToken}}"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            },
                            {
                                "key": "Accept",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"place_en\": \"Riyadh Convention Hall - Main Stage\",\n    \"place_ar\": \"قاعة مؤتمرات الرياض - المسرح الرئيسي\",\n    \"event_date\": \"2026-11-20 19:00:00\",\n    \"timezone\": \"Asia/Riyadh\"\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/api/v1/admin/events/{{eventId}}",
                            "host": ["{{baseUrl}}"],
                            "path": ["api", "v1", "admin", "events", "{{eventId}}"]
                        },
                        "description": "Partially or fully updates an existing event. Unspecified fields are preserved. Supports both PUT and PATCH."
                    }
                },
                {
                    "name": "2.6 Admin - Publish Event",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test('Status code is 200 OK', function () {",
                                    "    pm.response.to.have.status(200);",
                                    "});",
                                    "",
                                    "var jsonData = pm.response.json();",
                                    "if (jsonData && jsonData.data && jsonData.data.slug) {",
                                    "    pm.collectionVariables.set('slug', jsonData.data.slug);",
                                    "    console.log('Published event slug: ' + jsonData.data.slug);",
                                    "}"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{adminToken}}"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            },
                            {
                                "key": "Accept",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"cover_image_url\": \"https://images.unsplash.com/photo-1540575467063-178a50c2df87\"\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/api/v1/admin/events/{{eventId}}/publish",
                            "host": ["{{baseUrl}}"],
                            "path": ["api", "v1", "admin", "events", "{{eventId}}", "publish"]
                        },
                        "description": "Validates full bilingual completeness and transitions status to published. If cover_image_url (or any other required field) was already saved in the draft, an empty body '{}' is accepted. Any fields included here will update the draft before publishing."
                    }
                },
                {
                    "name": "2.7 Admin - Delete Attempt by Editor (Forbidden 403 Test)",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test('Status code is 403 Forbidden for Editor', function () {",
                                    "    pm.response.to.have.status(403);",
                                    "});"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "DELETE",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{editorToken}}"
                            },
                            {
                                "key": "Accept",
                                "value": "application/json"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/api/v1/admin/events/{{eventId}}",
                            "host": ["{{baseUrl}}"],
                            "path": ["api", "v1", "admin", "events", "{{eventId}}"]
                        },
                        "description": "Security test verifying that an Editor receives HTTP 403 Forbidden when attempting to delete an event."
                    }
                },
                {
                    "name": "2.8 Admin - Permanent Delete by Admin (Hard Delete)",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test('Status code is 200 OK on permanent deletion', function () {",
                                    "    pm.response.to.have.status(200);",
                                    "});"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "DELETE",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{adminToken}}"
                            },
                            {
                                "key": "Accept",
                                "value": "application/json"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/api/v1/admin/events/{{eventId}}",
                            "host": ["{{baseUrl}}"],
                            "path": ["api", "v1", "admin", "events", "{{eventId}}"]
                        },
                        "description": "Permanently hard-deletes an event from the database. Strictly restricted to Administrator role."
                    }
                }
            ]
        }
    ]
}
