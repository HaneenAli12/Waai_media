    "item": [
        {
            "name": "Public API",
            "item": [
                {
                    "name": "1. Public - Get Paginated Clients (Home Page)",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test('Status code is 200 OK', function () {",
                                    "    pm.response.to.have.status(200);",
                                    "});",
                                    "var json = pm.response.json();",
                                    "pm.test('Response has paginated structure', function () {",
                                    "    pm.expect(json).to.have.property('data');",
                                    "    pm.expect(json).to.have.property('links');",
                                    "    pm.expect(json).to.have.property('meta');",
                                    "    pm.expect(Array.isArray(json.data)).to.be.true;",
                                    "});",
                                    "if (json.data.length > 0) {",
                                    "    pm.test('Public resource exposes only id, name, logo_url', function () {",
                                    "        var item = json.data[0];",
                                    "        pm.expect(item).to.have.property('id');",
                                    "        pm.expect(item).to.have.property('name');",
                                    "        pm.expect(item).to.have.property('logo_url');",
                                    "        pm.expect(item).to.not.have.property('logo_path');",
                                    "        pm.expect(item).to.not.have.property('created_at');",
                                    "        pm.expect(item).to.not.have.property('updated_at');",
                                    "    });",
                                    "}"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            }
                        ],
                        "url": {
