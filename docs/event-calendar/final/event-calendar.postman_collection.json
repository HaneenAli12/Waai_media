                        "description": "Partially or fully updates an existing event. Omitted fields are preserved. Server-controlled lifecycle fields (status, slug, published_at) are stripped. If published, mandatory fields cannot be cleared. Supports both PUT and PATCH."
                    },
                    "response": []
                },
                {
                    "name": "2.6 Admin - Publish Event",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test('Status code is 200 OK', function () {",
                                    "    pm.response.to.have.status(200);",
                                    "});",
                                    "",
                                    "var jsonData = pm.response.json();",
                                    "if (jsonData && jsonData.data && jsonData.data.slug) {",
                                    "    pm.collectionVariables.set('slug', jsonData.data.slug);",
                                    "    console.log('Published event slug: ' + jsonData.data.slug);",
