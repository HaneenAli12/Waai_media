{
  "info": {
    "name": "Waai Media - Authentication API",
    "description": "Authentication API collection for Waai Media Laravel backend. Set the collection variable base_url to the reachable Laravel API host (without /api/v1). Vercel hosting the Angular frontend does not by itself make the Laravel backend publicly reachable. Use a test account and do not commit real passwords or tokens.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000",
      "type": "string"
    },
    {
      "key": "email",
      "value": "test@example.com",
      "type": "string"
    },
    {
      "key": "password",
      "value": "Secret123!",
      "type": "string"
    },
    {
      "key": "device_name",
      "value": "Postman Desktop",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "otp",
      "value": "",
      "type": "string"
    },
    {
      "key": "reset_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "new_password",
      "value": "NewSecret123!",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1 - Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"device_name\": \"{{device_name}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{base_url}}/api/v1/auth/login"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 200) {",
              "  const data = pm.response.json();",
              "  if (data.token) pm.collectionVariables.set('token', data.token);",
              "  if (data.session_id) pm.collectionVariables.set('session_id', String(data.session_id));",
              "}",
              "pm.test('Login returns 200', function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "2 - Forgot Password (Request OTP)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{base_url}}/api/v1/auth/forgot-password",
        "description": "Returns a generic message. For an existing test account, check the configured mail inbox/logs for the real OTP. Respect the backend resend cooldown."
      }
    },
    {
      "name": "3 - Verify OTP",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"otp\": \"{{otp}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{base_url}}/api/v1/auth/verify-otp",
        "description": "Enter the actual 4-digit OTP in the collection variable otp before sending."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 200) {",
              "  const data = pm.response.json();",
              "  if (data.reset_token) pm.collectionVariables.set('reset_token', data.reset_token);",
              "}",
              "pm.test('OTP verification returns 200 when valid', function () { pm.expect(pm.response.code).to.be.oneOf([200, 400, 422, 429]); });"
            ]
          }
        }
      ]
    },
    {
      "name": "4 - Reset Password",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"reset_token\": \"{{reset_token}}\",\n  \"password\": \"{{new_password}}\",\n  \"password_confirmation\": \"{{new_password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{base_url}}/api/v1/auth/reset-password",
        "description": "Uses the single-use reset_token captured from Verify OTP. Successful reset revokes all active sessions/tokens."
      }
    },
    {
      "name": "5 - Get Current User (/me)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{base_url}}/api/v1/auth/me",
        "description": "Requires a token saved by Login. The returned session should belong to the current token/device."
      }
    },
    {
      "name": "6 - Logout",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{base_url}}/api/v1/auth/logout",
        "description": "Revokes only the token used for this request. After logout, /me with this token should return 401."
      }
    },
    {
      "name": "7 - Change Password",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"current_password\": \"{{password}}\",\n  \"password\": \"{{new_password}}\",\n  \"password_confirmation\": \"{{new_password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{base_url}}/api/v1/auth/change-password",
        "description": "Keeps the current token active and revokes other devices' sessions. After success, update the password variable if testing login again."
      }
    }
  ]
}