{
  "info": {
    "_postman_id": "b1090123-8e4a-49c7-b521-7e829dc7a102",
    "name": "Waai Media - Blogs Module API",
    "description": "Comprehensive Postman v2.1 API collection for the Waai Media Blogs Module (`/api/v1`).\n\n### Prerequisites\n1. Run local Laravel server (`php artisan serve`).\n2. Run database migrations and seeders (`php artisan migrate --seed`).\n3. Authenticate using the dedicated Authentication Collection (`docs/Waai_Media_Authentication_API.postman_collection.json`) or Postman Environment to obtain valid Sanctum tokens with the `'access'` ability, and populate `{{admin_token}}` and `{{editor_token}}` before running protected Admin requests.\n4. For Image Uploads (Folder 3), select a local `.jpg`, `.png`, or `.webp` file (`<= 10 MB`) in the `image` form-data field.\n\n### Safety Guard\nDestructive permanent deletion (`DELETE /api/v1/admin/blogs/{{delete_target_blog_id}}`) is guarded by a pre-request script checking `run_destructive_delete === \"true\"`.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Public Blog Endpoints",
      "description": "Publicly accessible endpoints (`/api/v1/blogs`). No authentication required. Draft articles are strictly isolated and return HTTP 404.",
      "item": [
        {
          "name": "Get Latest Homepage Blogs (Default Limit 3)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const res = pm.response.json();",
                  "pm.test('Response contains data array with at most 3 items', function () {",
                  "    pm.expect(res).to.have.property('data');",
                  "    pm.expect(res.data).to.be.an('array');",
                  "    pm.expect(res.data.length).to.be.at.most(3);",
                  "});",
                  "",
                  "if (res.data.length > 0) {",
                  "    const item = res.data[0];",
                  "    pm.test('Card contains required bilingual public fields', function () {",
                  "        pm.expect(item).to.have.property('id');",
                  "        pm.expect(item).to.have.property('slug');",
                  "        pm.expect(item).to.have.property('title_ar');",
                  "        pm.expect(item).to.have.property('title_en');",
                  "        pm.expect(item).to.have.property('short_description_ar');",
                  "        pm.expect(item).to.have.property('short_description_en');",
                  "        pm.expect(item).to.have.property('category');",
                  "        pm.expect(item).to.have.property('category_name_ar');",
                  "        pm.expect(item).to.have.property('category_name_en');",
                  "        pm.expect(item).to.have.property('featured_image_url');",
                  "        pm.expect(item).to.have.property('published_at');",
                  "    });",
                  "    pm.test('Card excludes duplicate generic fields', function () {",
                  "        pm.expect(item).to.not.have.property('title');",
                  "        pm.expect(item).to.not.have.property('author_name');",
                  "        pm.expect(item).to.not.have.property('short_description');",
                  "        pm.expect(item).to.not.have.property('content');",
                  "        pm.expect(item).to.not.have.property('category_name');",
                  "    });",
                  "    pm.test('Public card does not leak internal storage/admin metadata', function () {",
                  "        pm.expect(item).to.not.have.property('uploaded_by');",
                  "        pm.expect(item).to.not.have.property('storage_key');",
                  "        pm.expect(item).to.not.have.property('deleting_at');",
                  "        pm.expect(item).to.not.have.property('editor_images');",
                  "    });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Accept-Language",
                "value": "en",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/blogs/latest",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "blogs",
                "latest"
              ]
            }
          }
        },
